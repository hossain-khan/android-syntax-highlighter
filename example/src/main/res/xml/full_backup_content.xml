<?xml version="1.0" encoding="utf-8"?>
<!--
    Full backup content rules for Android 11 and below.
    This demo app does not contain any user data, so all backup domains
    are excluded.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
